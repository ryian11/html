def make_think_ans(page):
    th = PAGES[page]['think']
    conts = ['\t\t\t\t\t\t\t\t\t' + sc(s, en, kr) for s, en, kr in th['ex']]
    return THINK_ANS.format(page=page, conts='\n'.join(conts))




def intro_page():
    """Read Smart 도입 페이지 이름 (첫 본문 쪽의 _01).

    들머리 쪽이 없는 단원(Special Lesson)에서는 None — 그 쪽을 만들지 않는다.
    """
    if not READSMART:
        return None
    return ORDER[0][:4] + '_01'


def all_popup():
    return ORDER[0] + '_all'


def think_page():
    for p in ORDER:
        if PAGES[p].get('think'):
            return p
    return None


def build(lesson=None, out=None, only=None):
    """only 를 주면 그 쪽만 쓴다. 안 주면 예전 그대로 단원 전체.

    단원 공통 파일(들머리 쪽 · 전체듣기 팝업 · 예시답안)은 단원 전체 자료에서
    나오므로 only 와 상관없이 늘 쓴다.
    """
    if lesson is not None:
        load_lesson(lesson, out)
    want = set(only) if only else None
    wg = load_words()
    sy = load_syntax()
    _intro = intro_page()
    if _intro:
        write('%s/%s.html' % (OUT, _intro), READSMART)
    for page in ORDER:
        if want and page not in want:
            continue
        words = wg[WORDPAGE[page]] if page in WORDPAGE else []
        syn = sy[P.pgkey(PAGES[page]['num'])]
        write('%s/%s.html' % (OUT, page), make_page(page, SCROLLS.get(page, {})))
        write('%s/css/%s.css' % (OUT, page), make_css(page))
        write('%s/js/%s.js' % (OUT, page), make_js(page, words, syn))
        write('%s/popup/%s_kor1.html' % (OUT, page), make_kor1(page))
        print('  %s  단어 %d  구문 %d' % (page, len(words), len(syn)))
    tp = think_page()
    if tp:
        write('%s/popup/%s_think_ans1.html' % (OUT, tp), make_think_ans(tp))
    allhtml, cnt = make_all()
    write('%s/popup/%s.html' % (OUT, all_popup()), allhtml)
    print('  _all script-cont %d개 (마지막 인덱스 %d)' % (cnt, cnt - 1))
    return cnt


if __name__ == '__main__':
    n = int(sys.argv[1]) if len(sys.argv) > 1 else 6
    out = None
    if '--out' in sys.argv:
        out = sys.argv[sys.argv.index('--out') + 1]
    print('[build] lesson%02d' % n)
    build(n, out)
    print('[build] ->', OUT)
