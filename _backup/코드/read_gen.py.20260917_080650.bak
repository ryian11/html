# -*- coding: utf-8 -*-
"""Reading 본문 페이지 생성 엔진 (단원 무관)

  python read_gen.py 6            → lesson06/ops 에 바로 쓴다
  python read_gen.py 6 --out tmp  → tmp 폴더에 쓴다

단원별 원고·레이아웃 값은 data<N>.py 에 있다.
측정값(scrolls<N>.py / krlayout<N>.py / popscroll<N>.py)은 read_measure.py 가 만든다.
"""
import os, re, sys, importlib, openpyxl
import read_paths as P

PAGES = ORDER = IMG = None
WORDBTN = CSS_LAYOUT = READSMART = None
SCROLLS = KRLAYOUT = POPKOR1 = POPALL = None
WORDPAGE = {}
LESSON = None
SB = None
OUT = None


_HAS_DIC = {}


def has_dictation():
    """이 단원에 딕테이션이 있나 — 스토리보드에 'Dictation' 시트가 있는지로 본다.

    Special Lesson 처럼 딕테이션이 아예 없는 단원도 있다. 그러면 단추도 팝업도 내지 않는다.
    (딕테이션 팝업 파일 자체는 이 레시피가 아니라 딕테이션 작업에서 만든다.)
    """
    if SB in _HAS_DIC:
        return _HAS_DIC[SB]
    ok = False
    try:
        wb = openpyxl.load_workbook(SB, read_only=True)
        ok = any('dictation' in n.lower() for n in wb.sheetnames)
        wb.close()
    except Exception:
        ok = False
    _HAS_DIC[SB] = ok
    return ok


def _page_has_word(pg):
    """그 쪽에 미니 단어장 낱말이 있나 ([mark:n: …] 가 붙어 있나)"""
    chunks = []
    t = pg.get('title')
    if t:
        chunks.append(t.get('mark', '') or '')
    for kind, b in pg['blocks']:
        if kind in ('subtit', 'label'):
            chunks.append(b.get('mark', '') or '')
            chunks.append(b.get('en', '') or '')
        else:
            chunks += [en for _, en, _ in b]
    return '[mark:' in ''.join(chunks)


def load_lesson(n, out=None):
    """data<N>.py 와 (있으면) 측정값 모듈을 읽어 전역에 올린다."""
    global PAGES, ORDER, IMG, WORDBTN, CSS_LAYOUT, READSMART
    global SCROLLS, KRLAYOUT, POPKOR1, POPALL, WORDPAGE, LESSON, SB, OUT
    LESSON = n
    D = importlib.import_module('data%s' % n)
    PAGES, ORDER, IMG = D.PAGES, D.ORDER, D.IMG
    WORDBTN, CSS_LAYOUT, READSMART = D.WORDBTN, D.CSS_LAYOUT, D.READSMART
    # 미니 단어장 묶음은 시트에서 빈 줄로 나뉘어 오고, **낱말이 있는 쪽에만** 있다.
    # 자리 번호로 세면 낱말 없는 쪽(Special Lesson 156쪽)이 끼었을 때 하나씩 밀린다.
    WORDPAGE = {}
    _gi = 0
    for _p in ORDER:
        if _page_has_word(PAGES[_p]):
            WORDPAGE[_p] = _gi
            _gi += 1
    SB = P.storyboard(n)
    OUT = out or P.ops(n)

    def opt(mod, attr, default):
        try:
            return getattr(importlib.import_module(mod % n), attr)
        except Exception:
            return default
    SCROLLS = opt('scrolls%s', 'SCROLLS', {})
    KRLAYOUT = opt('krlayout%s', 'KR', {})
    POPKOR1 = opt('popscroll%s', 'KOR1', {})
    POPALL = opt('popscroll%s', 'ALL', {})
    return D


def underlined(cell):
    """엑셀 서식에서 밑줄 친 글자만 뽑는다 (없으면 '')"""
    v = cell.value
    try:
        from openpyxl.cell.rich_text import TextBlock
    except ImportError:
        return ''
    if not hasattr(v, '__iter__') or isinstance(v, str):
        return ''
    out = [b.text for b in v if isinstance(b, TextBlock) and getattr(b.font, 'u', None)]
    return ' '.join(x.strip() for x in out if x.strip())


def load_words():
    wb_ = openpyxl.load_workbook(SB, data_only=True, rich_text=True)
    ws = wb_['미니 단어장']
    groups, cur = [], []
    for i, row in enumerate(ws.iter_rows(), 1):
        if i == 1:
            continue
        r = [c.value for c in row]
        w = (r[0] or '').strip() if isinstance(r[0], str) else r[0]
        if not w:
            if cur:
                groups.append(cur); cur = []
            continue
        if str(w).startswith('아래에'):
            break
        cells = [str(x).strip() if x else '' for x in r[:6]]
        cells.append(underlined(row[2]) if len(row) > 2 else '')   # 예문의 밑줄 부분
        cur.append(cells)
    if cur:
        groups.append(cur)
    return groups


def _pgnum(v):
    """스토리보드 '쪽' 칸 → 숫자만. '152쪽' · ' 152 ' 둘 다 '152' 로."""
    m = re.search(r'\d+', str(v or ''))
    return m.group(0) if m else str(v or '').strip()


def load_syntax():
    ws = openpyxl.load_workbook(SB, data_only=True)['구문 해설']
    out = {}
    for i, r in enumerate(ws.iter_rows(values_only=True), 1):
        if i == 1 or not r[0]:
            continue
        pg = P.pgkey(r[0])           # '152쪽' 도 '152' 로, '014' 와 '14' 도 한 쪽으로
        out.setdefault(pg, []).append((str(r[1]).strip(), str(r[2]).strip()))
    return out


POS = '명형동부전접대감수관'


def split_mean(s):
    """'동) 접근하다, 이용하다' -> [('동','접근하다, 이용하다')]  / '형) 못된 동) 의미하다' -> 2쌍
    품사 기호는 문자열 맨 앞이거나 공백 뒤에 오는 '<품사>) ' 만 인정한다.
    ('(신문 기사 등의) 제목' / '정보를 제공하는 활동)' 같은 뜻 안의 괄호와 구분)"""
    s = s.strip()
    marks = [m for m in re.finditer(r'(?:(?<=^)|(?<=\s))([%s])\)\s*' % POS, s)]
    if not marks:
        return [('', s)]
    pairs = []
    for i, m in enumerate(marks):
        end = marks[i + 1].start() if i + 1 < len(marks) else len(s)
        pairs.append((m.group(1), s[m.end():end].strip()))
    return pairs


def ex_mp3(word):
    return re.sub(r'\s+', '_', word.replace('...', '').strip()) + '_ex'


def bold_word(ex, word, marked=''):
    """예문에서 굵게 할 곳을 <b>로 감싼다.
    엑셀에 밑줄로 표시된 부분이 있으면 그것이 기준, 없으면 표제어 어간으로 찾는다."""
    if marked:
        i = ex.find(marked)
        if i >= 0:
            return ex[:i] + '<b>' + marked + '</b>' + ex[i + len(marked):], True
    stem = word.strip()
    if ' ' in stem:
        pat = re.compile(re.escape(stem).replace(r'\ ', r'\s+'), re.I)
    else:
        base = re.sub(r'(e|y)$', '', stem)
        pat = re.compile(r'\b' + re.escape(base) + r'[a-z]*', re.I)
    m = pat.search(ex)
    if not m:
        return ex, False
    return ex[:m.start()] + '<b>' + m.group(0) + '</b>' + ex[m.end():], True


# ---------- 본문 마크업 ----------
def lt(cls, scroll, src, text):
    a = ''
    if cls:
        a += ' class="%s"' % cls
    if scroll:
        a += ' scrollTop="%s"' % scroll
    return '<comp-language-target%s src="media/mp3/%s.mp3" text="%s"></comp-language-target>' % (a, src, text)


def body_html(page, scrolls):
    p = PAGES[page]
    n = p['num']
    L = []
    t = p['title']
    if t:
        L.append('              ' + lt(t['cls'], scrolls.get(t['src'], ''), t['src'], t['mark']))
        L.append('')
    for kind, blk in p['blocks']:
        if kind == 'label':
            L.append('              ' + lt(blk['cls'], scrolls.get(blk['src'], ''), blk['src'], blk['en']))
            L.append('')
    L.append('              <div class="ParagraphBox">')
    pi = 0
    for kind, blk in p['blocks']:
        if kind in ('label',):
            continue
        if kind == 'subtit':
            L.append('              </div>')
            L.append('')
            L.append('              ' + lt(blk['cls'], scrolls.get(blk['src'], ''), blk['src'], blk['mark']))
            L.append('')
            L.append('              <div class="ParagraphBox Tip">')
            continue
        cls = 'Paragraph tipItem' if kind == 'tip' else 'Paragraph'
        extra = (p.get('paracls') or {}).get(pi)
        if extra:
            cls += ' ' + extra
        pi += 1
        L.append('                <!-- Paragraph -->')
        L.append('                <div class="%s">' % cls)
        for idx, en, kr in blk:
            src = '3_%s_read_%s' % (n, idx)
            L.append('                  ' + lt('', scrolls.get(src, ''), src, en))
        L.append('                </div>')
    L.append('              </div>')
    return '\n'.join(L)


# ---------- 규칙 (rules/<레시피>/rules.json) ----------
# 프로토 HTML 에서 뽑아 둔 값을 여기서 읽어 쓴다.
# 파일이 없거나 항목이 비어 있으면 R() 이 기본값(=여태 쓰던 값)을 돌려주므로
# 결과가 달라지지 않는다. 교재가 바뀌면 프로토만 새로 분석하면 된다.
RULES = {}


def load_rules(rid):
    """rules/<레시피>/rules.json 을 읽어 둔다. 없으면 빈 채로 둔다."""
    global RULES
    RULES = {}
    if not rid:
        return RULES
    import json, io as _io
    p = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'rules', rid, 'rules.json')
    if not os.path.isfile(p):
        return RULES
    try:
        d = json.loads(_io.open(p, encoding='utf-8').read())
    except Exception:
        return RULES
    for k, v in (d.get('items') or {}).items():
        if isinstance(v, dict) and v.get('value') is not None:
            RULES[k] = v['value']
    return RULES


def R(key, default):
    """규칙 값. 없으면 여태 쓰던 값."""
    v = RULES.get(key)
    return default if v is None else v


def _fill(t, page):
    """규칙에 적힌 {page}·{lesson} 자리를 채운다."""
    return str(t).replace('{page}', page).replace('{lesson}', str(LESSON))


