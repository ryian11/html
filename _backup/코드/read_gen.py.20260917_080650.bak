%s
          </div>
        </div>
      </div>
    </div>
''' % (popidx, '\n'.join(body))


def head_fill(page):
    """HEAD 에 채울 규칙 값. 규칙이 없으면 여태 쓰던 값 그대로."""
    return dict(
        bodyCss='\n'.join('  <link rel="stylesheet" href="%s">' % _fill(u, page)
                          for u in R('skeleton.body.css', CSS_DEF)),
        bodyJs='\n'.join('  <script src="%s"></script>' % _fill(u, page)
                         for u in R('skeleton.body.js', JS_DEF)),
        speedBtn=R('skeleton.body.speedBtn', SPEED_DEF),
        video=_fill(R('assets.video', 'media/mp4/l{lesson}_read.mp4'), page),
        videoScript=_fill(R('assets.videoScript', 'media/mp4/l{lesson}_read_script.mp4'), page),
        vtt=_fill(R('assets.vtt', 'media/mp4/l{lesson}_read.vtt'), page),
        pVideo=R('popup.video', 1),
        pVideoBtn=R('popup.btn.videoPopBtn', 1),
        pListen=R('popup.btn.listenTotalBtn', 2),
        pListenBtn=R('popup.btn.listenTotalBtn', 2),
        pKor=R('popup.btn.korBtn', 3),
        pKorBtn=R('popup.btn.korBtn', 3),
    )


def make_page(page, scrolls):
    p = PAGES[page]
    has_think = bool(p.get('think'))
    has_mission = bool(p.get('mission'))
    # 리딩퀴즈 팝업 번호: 마지막 쪽만 9, 나머지는 7 (3단원 원본 확인)
    #   p050_02=7  p051_01=7  p052_01=7(+thinkabout 8)  p053_01=9(+missionclear 10)
    popidx = 9 if page == ORDER[-1] else 7
    # 리딩 퀴즈가 없는 단원도 있다(Special Lesson). 그러면 질문 단추도 퀴즈 팝업도 없다.
    has_quiz = bool((p.get('quiz') or {}).get('kind'))
    # 하단 버튼 박스
    bot = ['            <div class="readingBtnBox Bot direcR">',
           '              <div class="btnBox">']
    if has_quiz:
        bot += ['                <button class="js-openPopBtn questionBtn" data-pop-idx="%d">' % popidx,
                '                  <span>%s</span>' % p['qbtn'],
                '                </button>']
    if has_mission:
        bot.append('                <button class="js-openPopBtn missionClearBtn" data-pop-idx="10"></button>')
    bot.append('              </div>')
    if has_think:
        bot.append('              <div class="btnBox">')
        bot.append('                <button class="js-openPopBtn thinkAboutBtn" data-pop-idx="8"></button>')
        bot.append('              </div>')
    bot.append('            </div>')

    extrapop = ''
    qk = (p.get('quiz') or {}).get('kind')
    quizpop = ''
    bothdl = ''
    if has_quiz:
        quizpop = (quiz_input(p['quiz'], popidx) if qk == 'input'
                   else quiz_input2(p['quiz'], popidx) if qk == 'input2'
                   else quiz_tf(p['quiz'], popidx))

        bothdl = '''      <!-- popup -->
      <div class="js-btnHandler btnHandlerBox" data-cont-type="popup" data-pop-idx="%d">
        <div class="btnBundle">
          <comp-btn-group hdlQuiz="0"></comp-btn-group>
          <button class="js-sndEffect js-interpretItem korBtn" data-snd="click" data-interpret-idx="1"%s></button>
        </div>
      </div>''' % (popidx, ' data-disabled="true" data-hdl-idx="0"' if qk in ('input', 'input2') else '')

    if has_think:
        th = p['think']
        extrapop = '''
    <!-- thinkabout 예시 답안 팝업 -->
    <div class="js-popupContent popup Iframe" data-pop-idx="11">
      <iframe src="popup/%s_think_ans1.html" frameborder="0"></iframe>
      <button class="js-closePopBtn closePopBtn"></button>
    </div>
''' % page
        quizpop += '''
    <!-- thinkabout 팝업 -->
    <div class="js-popupContent popup" data-pop-idx="8" data-use="thinkabout" data-pop-inner="11">
      <div class="popContentContainer">
        <!-- popHeader -->
        <header class="popHeader">
          <div class="popHeaderInner">
            <strong class="js-narrationBtn narrText popHeaderTit" data-narr-idx="3" data-narr-src="include/media/common/think_about_this.mp3"></strong>
          </div>
          <button class="js-closePopBtn closePopBtn"></button>
        </header>

        <!-- popContent -->
        <div class="popContent">
          <!-- Header -->
          <header class="Header">
            <div class="headerInner Main arrayH">
              <div class="headerText" data-include="interpretText">
                <p class="js-narrationBtn narrText" data-narr-idx="4" data-narr-src="media/mp3/%s.mp3">
                  %s
                </p>
                <span class="js-interpretTarget interpretText" data-interpret-idx="2">%s</span>
              </div>
            </div>
          </header>

          <div class="writingBox Gr">
            <textarea class="pen" placeholder=" " rows="3"></textarea>
          </div>
        </div>
      </div>
    </div>
''' % (th['src'], th['q'], th['qkr'])
        bothdl += '''

      <!-- popup -->
      <div class="js-btnHandler btnHandlerBox" data-cont-type="popup" data-pop-idx="8">
        <div class="btnBundle">
          <button class="js-sndEffect js-interpretItem korBtn" data-snd="click" data-interpret-idx="2"></button>
          <button class="js-openPopBtn exAnswerBtn" data-pop-idx="11"></button>
        </div>
      </div>'''

    if has_mission:
        quizpop += '''
    <!-- missionclear 팝업 -->
    <div class="js-popupContent popup" data-pop-idx="10" data-use="missionclear">
      <div class="popContentContainer">
        <!-- popHeader -->
        <header class="popHeader">
          <div class="popHeaderInner">
            <strong class="js-narrationBtn narrText popHeaderTit" data-narr-idx="7" data-narr-src="include/media/common/mission_clear.mp3"></strong>
          </div>
          <button class="js-closePopBtn closePopBtn"></button>
        </header>

        <!-- popContent -->
        <div class="popContent">
          <div class="selfCheckBox">
            <div class="checkList">
              <div class="listTxt">
                <comp-translate kr="%s" en="%s" src="media/mp3/%s.mp3" narrIdx="3" clickIdx="1"></comp-translate>
              </div>
            </div>
            <comp-self-check id="01,02,03" name="check01"></comp-self-check>
          </div>
        </div>
      </div>
    </div>
''' % (p['mission']['kr'], p['mission']['en'], p['mission']['src'])

    dic = has_dictation()
    dicpop = ('''    <!-- dictation 팝업 -->
    <div class="js-popupContent popup Iframe" data-pop-idx="4">
      <iframe src="popup/%s_dic1.html" frameborder="0"></iframe>
      <button class="js-closePopBtn closePopBtn"></button>
    </div>
''' % page) if dic else ''
    dicbtn = ('\n          <button class="js-openPopBtn dictationBtn" data-pop-idx="4"></button>'
              if dic else '')
    return HEAD.format(lesson=LESSON, page=page, body=body_html(page, scrolls), botbtn='\n'.join(bot),
                       extrapop=extrapop, quizpop=quizpop, bothdl=bothdl, allpop=all_popup(),
                       dicpop=dicpop, dicbtn=dicbtn, **head_fill(page))


# ---------- js ----------
def make_js(page, words, syn):
    p = PAGES[page]
    n = p['num']
    L = ['// 미니 단어장 data-use="word"', 'var wordData = [']
    for i, w in enumerate(words, 1):
        word, mean, ex, exko = w[0], w[1], w[2], w[3]
        marked = w[6] if len(w) > 6 else ''
        pairs = split_mean(mean)
        exb, ok = bold_word(ex, word, marked)
        L.append('  {')
        L.append('    index: %d,' % i)
        L.append('    wordArr: "%s",' % word)
        L.append('    wordMp3Arr: "media/mp3/3_%s_word_%02d.mp3",' % (n, i))
        L.append('    wordClassArr: "%s",' % pairs[0][0])
        L.append('    wordMeanArr: "%s",' % pairs[0][1])
        L.append('    wordExEgArr: "%s",' % exb.replace('"', '\\"'))
        L.append('    wordExMp3Arr: "media/mp3/%s.mp3",' % ex_mp3(word))
        L.append('    wordExKoArr: "%s"%s' % (exko.replace('"', '\\"'), ',' if len(pairs) > 1 else ''))
        if len(pairs) > 1:
            L.append('')
            L.append('    wordClassArr2: "%s",' % pairs[1][0])
            L.append('    wordMeanArr2: "%s"' % pairs[1][1])
        if not ok:
            print('  [경고] 예문에서 표제어 못 찾음:', page, word, '|', ex)
        L.append('  },')
    L.append(']')
    L.append('')
    L.append('// 구문 해설 data-use="syntax"')
    L.append('var syntaxData = [')
    # 구문 문장 -> 본문 mp3 찾기
    sent2src = {}
    for kind, blk in p['blocks']:
        if kind in ('subtit', 'label'):
            continue
        for idx, en, kr in blk:
            plain = re.sub(r'\|\d+\|', '', en)
            plain = re.sub(r'\[mark:\d+:\s*([^\]]*)\]', r'\1', plain)
            sent2src[norm(plain)] = '3_%s_read_%s' % (n, idx)
    for i, (sent, cmt) in enumerate(syn, 1):
        src = sent2src.get(norm(sent))
        if not src:                      # 한 문장이 여러 take 로 나뉜 경우 앞부분으로 찾는다
            key = norm(sent)
            for k2, v2 in sent2src.items():
                if k2 and (key.startswith(k2) or k2.startswith(key[:30])):
                    src = v2
                    break
        if not src:
            cand = [k for k in sent2src if norm(sent)[:40] in k]
            src = sent2src[cand[0]] if cand else 'XXX'
            if src == 'XXX':
                print('  [경고] 구문 문장 매칭 실패:', page, sent[:60])
        cmt = cmt.replace('「', "<span class='cursiveB'>「</span>").replace('」', "<span class='cursiveB'>」</span>")
        L.append('  {')
        L.append('    index: %d,' % i)
        L.append('    syntaxArr: "%s",' % sent.replace('"', '\\"'))
        L.append('    syntaxMp3Arr: "media/mp3/%s.mp3",' % src)
        L.append('    syntaxCmtArr: "%s",' % cmt.replace('"', '\\"'))
        L.append('  },')
    L.append(']')
    return '\n'.join(L)


def norm(s):
    return re.sub(r'[^a-z0-9]', '', s.lower().replace('’', "'"))


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'wb') as f:
        f.write(text.replace('\r\n', '\n').replace('\n', '\r\n').encode('utf-8'))


# ---------- css ----------

# ※ 문단 위치·여백 수치는 배경 이미지를 보고 잡은 1차 추정치. 실기 확인 후 조정 필요.


def make_css(page):
    img = IMG.get(page) or {}
    p = PAGES[page]
    L = ['@charset "utf-8";',
         '.readingCont {',
         '\twidth: 100%;']
    if 'bg' in img:
        L.append('\theight: calc(%dpx/2);' % img['bg'][1])
    L += ['\tpadding-top: 70px;',
         '\tbackground: url(../images/%s/read_bg.png) top center / 100%% no-repeat;' % page,
         '}',
         '']
    # 제목 / 소제목
    tits = [(p['title']['cls'].split()[-1], p['title'])] if p['title'] else []
    for kind, blk in p['blocks']:
        if kind == 'subtit':
            tits.append((blk['cls'].split()[-1], blk))
    keymap = {'mainTitle': 'title'}
    fname = {'mainTitle': 'title'}
    for _i in range(1, 9):
        keymap['sTit%02d' % _i] = 's%d' % _i
        fname['sTit%02d' % _i] = 's_title%02d' % _i
    for cls, t in tits:
        wh = img.get(keymap[cls])
        base = fname[cls]
        sel = '.mainTitle' if cls == 'mainTitle' else '.subTitle.%s' % cls
        if cls != 'mainTitle':
            L.append('.readingCont .subTitle { display: block; cursor: pointer; }')
        L.append('%s {' % sel)
        if wh:
            L.append('\twidth: calc(%dpx/2);' % wh[0])
            L.append('\theight: calc(%dpx/2);' % wh[1])
        L.append('\tmargin: %s;' % ('0 auto 50px' if cls == 'mainTitle' else '0 0 20px'))
        L.append('\tbackground: url(../images/%s/%s.png) top %s / 100%% no-repeat;'
                 % (page, base, 'center' if cls == 'mainTitle' else 'left'))
        L.append('}')
        L.append('%s.on { background-image: url(../images/%s/%s_h.png); }' % (sel, page, base))
        L.append('.isPlayAgaing %s.on { background-image: url(../images/%s/%s_b.png); }' % (sel, page, base))
        L.append('')
    # 제목/소제목 이미지 위 단어 버튼 (렌더링 보고 잡은 값)
    marks = re.findall(r'\[mark:(\d+):', p['title']['mark'] if p['title'] else '')
    for k, m in enumerate(marks):
        bl, bt = WORDBTN[page][k]
        L.append('button[data-word="%s"] { top: %dpx; left: %dpx; }' % (m, bt, bl))
    if marks:
        L.append('')
    L.append(CSS_LAYOUT[page].strip())
    L.append('')
    L.append('/* 리딩퀴즈 */')
    if (p.get('quiz') or {}).get('kind') in ('input', 'input2'):
        L.append('.popup[data-use="readingQuiz"] .readingAnswer .inputBox { width: 100%;}')
    return '\n'.join(L)


# ---------- kor1 / _all 팝업 ----------
def sc(src, en, kr, scroll='', rel='../media/mp3/'):
    a = ''
    if scroll:
        a += ' scrollTop="%s"' % scroll
    return '<script-cont%s src="%s%s.mp3" en="%s" kr="%s"></script-cont>' % (a, rel, src, en, kr)


def plain(en):
    s = re.sub(r'\|\d+\|', '', en)
    s = re.sub(r'\[mark:\d+:\s*([^\]]*)\]', r'\1', s)
    return re.sub(r'<br>', ' ', s).strip()


def script_boxes(page, indent='\t\t\t\t', pscroll=None):
    """kor1 / _all 공용 — (줄 리스트, script-cont 개수)
    kr 은 krlayout.KR 의 줄 배치 값을 쓴다 (없으면 원문 그대로)."""
    p = PAGES[page]
    n = p['num']
    kl = KRLAYOUT.get(page)
    ps = pscroll or {}
    L, cnt = [], 0

    def kr_of(i, fallback):
        return kl[i] if kl and i < len(kl) else fallback

    t = p['title']
    if t:
        cls = 'titBox' if t['cls'] == 'mainTitle' else 'subTitBox'
        L.append('%s<!-- %s -->' % (indent, cls))
        L.append('%s<comp-script-box class="%s">' % (indent, cls))
        L.append('%s\t%s' % (indent, sc(t['src'], t['en'], kr_of(cnt, t['kr']), ps.get(t['src'], ''))))
        L.append('%s</comp-script-box>' % indent)
        cnt += 1
    for kind, blk in p['blocks']:
        if kind == 'label':
            L.append('%s<!-- scriptBox -->' % indent)
            L.append('%s<comp-script-box>' % indent)
            L.append('%s\t%s' % (indent, sc(blk['src'], blk['en'], kr_of(cnt, blk['kr']), ps.get(blk['src'], ''))))
            L.append('%s</comp-script-box>' % indent)
            cnt += 1
            continue
        if kind == 'subtit':
            L.append('%s<!-- subTitBox -->' % indent)
            L.append('%s<comp-script-box class="subTitBox">' % indent)
            L.append('%s\t%s' % (indent, sc(blk['src'], blk['en'], kr_of(cnt, blk['kr']), ps.get(blk['src'], ''))))
            L.append('%s</comp-script-box>' % indent)
            cnt += 1
            continue
        L.append('%s<!-- scriptBox -->' % indent)
        L.append('%s<comp-script-box>' % indent)
        for idx, en, kr in blk:
            L.append('%s\t%s' % (indent, sc('3_%s_read_%s' % (n, idx), plain(en), kr_of(cnt, kr), ps.get('3_%s_read_%s' % (n, idx), ''))))
            cnt += 1
        L.append('%s</comp-script-box>' % indent)
    return L, cnt


