              </div>
            </div>''' % (q['label'][i], it['src'], it['q'], it['qkr'], it['ans'], cid, cid, cid + 1, cid + 1, i))
        cid += 2
    return '''    <!-- readingQuiz 팝업 -->
    <div class="js-popupContent popup" data-pop-idx="%d" data-use="readingQuiz" data-pop-opts="noClose">
      <div class="popContentContainer">
