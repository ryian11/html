def quiz_tf(q, popidx):
    body = []
    cid = 1
    for i, it in enumerate(q['items']):
        body.append('''            <!-- quizTitBox -->
            <div class="quizTitBox">
              <span class="marker read">%s</span>
              <div class="readingQuestion" data-include="interpretText">
                <p class="js-narrationBtn narrText" data-narr-idx="3" data-narr-src="media/mp3/%s.mp3">%s</p>
                <span class="js-interpretTarget interpretText" data-interpret-idx="1">%s</span>
              </div>

              <!-- quizItem -->
