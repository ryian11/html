def make_all():
    boxes, starts, cnt = [], [], 0
    for page in ORDER:
        starts.append(cnt)
        b, c = script_boxes(page, '\t\t\t\t', POPALL)
        boxes += b
        cnt += c
    last = cnt - 1
    lastnum = PAGES[ORDER[-1]]['num']
    labels = ['전체'] + ['%s~%s쪽' % (PAGES[p]['num'], lastnum) for p in ORDER[1:-1]] + ['%s쪽' % lastnum]
    idxs = [0] + starts[1:]
    mb = []
    for i, (lab, st) in enumerate(zip(labels, idxs)):
        mb.append('\t\t\t\t\t\t\t<button class="js-scrollMoveBtn scrollMoveBtn%s" data-script-idx="%d,%d">'
                  % (' ON' if i == 0 else '', st, last))
        mb.append('\t\t\t\t\t\t\t\t<span>%s</span>' % lab)
        mb.append('\t\t\t\t\t\t\t</button>')
    return ALL_HEAD.format(boxes='\n'.join(boxes), movebtn='\n'.join(mb), title=all_popup()), cnt


