#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""app.py 패치 — 단원 편집 UI(/api/project)가 project_rules.json 을 쓰도록 맞춘다.

recipes/cj_reading.py 의 units()/_register() 가 이제 project_rules.json 을
기준으로 삼는데, 여기(app.py)의 단원 편집 화면이 여전히 project.json 에만
쓰면 화면에서 고친 값이 생성에 반영되지 않는 채로 어긋난다. 같은 파일을
보도록 맞춘다.
"""
import sys, io

PATH = sys.argv[1]
src = io.open(PATH, encoding='utf-8').read()


def apply(old, new, label):
    global src
    n = src.count(old)
    if n != 1:
        raise SystemExit('[실패] %s — old 블록이 %d번 나타남(1이어야 함)' % (label, n))
    src = src.replace(old, new, 1)
    print('[적용] %s' % label)


OLD_POST = """            if u.path == '/api/project':
                import project_io
                rid = body['recipe']
                cur = {x['id']: x for x in project_io.units(rid)}
                n = 0
                for e in (body.get('units') or []):
                    row = cur.get(e.get('id'))
                    if not row:
                        continue
                    for k in ('name', 'sheet', 'guide'):
                        if k in e:
                            v = (e[k] or '').strip()
                            if v:
                                if row.get(k) != v:
                                    n += 1
                                row[k] = v
                            elif k in row:
                                row.pop(k)
                                n += 1
                project_io.put_units(rid, [cur[k] for k in sorted(
                    cur, key=lambda i: (0, int(i), '') if i.isdigit() else (1, 0, i))])
                runner.load_recipe(rid)          # 등록부를 다시 올린다
                return self._send(200, {'ok': True, 'changed': n})"""

NEW_POST = """            if u.path == '/api/project':
                import project_rules_io as PR
                rid = body['recipe']
                cur = {x['id']: x for x in PR.units()}
                n = 0
                for e in (body.get('units') or []):
                    row = cur.get(e.get('id'))
                    if not row:
                        continue
                    for k in ('name', 'sheet', 'guide'):
                        if k in e:
                            v = (e[k] or '').strip()
                            if v:
                                if row.get(k) != v:
                                    n += 1
                                row[k] = v
                            elif k in row:
                                row.pop(k)
                                n += 1
                PR.put_units([cur[k] for k in sorted(
                    cur, key=lambda i: (0, int(i), '') if i.isdigit() else (1, 0, i))])
                runner.load_recipe(rid)          # 등록부를 다시 올린다
                return self._send(200, {'ok': True, 'changed': n})"""

apply(OLD_POST, NEW_POST, "/api/project POST")


OLD_GET = """    def _project(self, rid):
        \"\"\"단원별 자료 — 시트 이름 · 지도서 PDF 는 교재마다 다르다.\"\"\"
        import project_io
        m = runner.load_recipe(rid)
        ctx = runner.make_ctx(m, runner.load_settings().get(rid, {}))
        try:
            m.units(ctx)                          # 새 단원이 있으면 찾아 적어 둔다
        except Exception:
            pass
        import read_paths as P
        out = []
        for u in project_io.units(rid):
            g = project_io.abspath(P.ROOT, u.get('guide', ''))
            out.append({'id': u['id'], 'name': u.get('name', u['id']),
                        'sheet': u.get('sheet', ''), 'guide': u.get('guide', ''),
                        'guideOk': bool(u.get('guide')) and os.path.isfile(g),
                        'storyboard': u.get('storyboard', ''), 'ops': u.get('ops', '')})
        return {'recipe': rid, 'root': P.ROOT, 'units': out}"""

NEW_GET = """    def _project(self, rid):
        \"\"\"단원별 자료 — 시트 이름 · 지도서 PDF 는 교재마다 다르다.\"\"\"
        import project_rules_io as PR
        m = runner.load_recipe(rid)
        ctx = runner.make_ctx(m, runner.load_settings().get(rid, {}))
        try:
            m.units(ctx)                          # 새 단원이 있으면 찾아 적어 둔다
        except Exception:
            pass
        import read_paths as P
        out = []
        for u in PR.units():
            g = PR.abspath(P.ROOT, u.get('guide', ''))
            out.append({'id': u['id'], 'name': u.get('name', u['id']),
                        'sheet': u.get('sheet', ''), 'guide': u.get('guide', ''),
                        'guideOk': bool(u.get('guide')) and os.path.isfile(g),
                        'storyboard': u.get('storyboard', ''), 'ops': u.get('ops', '')})
        return {'recipe': rid, 'root': P.ROOT, 'units': out}"""

apply(OLD_GET, NEW_GET, "/api/project GET (_project)")

io.open(PATH, 'w', encoding='utf-8', newline='').write(src)
print('저장 완료:', PATH)
