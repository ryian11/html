        raise RuntimeError('프로토 단원을 정해 주세요.')
    ops = proto_ops(ctx)
    if not os.path.isdir(ops):
        raise RuntimeError('프로토 ops 폴더가 없습니다: %s' % ops)
    sb = P.storyboard(n) if os.path.isfile(P.storyboard(n)) else None
