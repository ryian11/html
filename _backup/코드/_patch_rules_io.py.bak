#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""rules_io.py 패치 —
  1) values(rid) 헬퍼 추가 (read_gen.py/read_import.py 가 함께 쓸 수 있게)
  2) code_rules() 의 sound.sheet/col.id/col.text/mp3 스크래핑을, 이제는
     맞지 않는 옛 정규식 대신 read_import.py 의 R('key', 기본값) 호출을
     그대로 훑는 일반적인 방식으로 바꾼다(대조 기능 유지).
"""
import sys, io

PATH = sys.argv[1]
src = io.open(PATH, encoding='utf-8').read()


def apply(old, new, label):
    global src
    n = src.count(old)
    if n != 1:
        raise SystemExit('[실패] %s — old 블록이 %d번 나타남(1이어야 함)' % (label, n))
    src = src.replace(old, new, 1)
    print('[적용] %s' % label)


# ---------------------------------------------------------------- 1) values() 추가
OLD_LOAD = """def load(path):
    if not os.path.isfile(path):
        return None
    return json.loads(io.open(path, encoding='utf-8').read())"""

NEW_LOAD = """def load(path):
    if not os.path.isfile(path):
        return None
    return json.loads(io.open(path, encoding='utf-8').read())


def values(rid):
    \"\"\"rules.json 의 item→value 만 뽑아 돌려준다. 없으면 빈 dict.

    read_gen.py 의 load_rules() 와 read_import.py 의 load_rules() 가
    똑같은 모양으로 이 함수를 쓴다 — rules.json 을 읽는 곳을 한 곳으로 모은다.
    \"\"\"
    d = load(rules_path(rid)) if rid else None
    out = {}
    for k, v in (d.get('items') or {}).items() if d else []:
        if isinstance(v, dict) and v.get('value') is not None:
            out[k] = v['value']
    return out"""

apply(OLD_LOAD, NEW_LOAD, 'values() 추가')


# ---------------------------------------------------------------- 2) code_rules() 의 음원 스크래핑 교체
OLD_SOUND_SCRAPE = """    # --- 소스에서: 음원·시트
    m = re.search(r"IDPAT = re\\.compile\\(r'([^']+)'\\)", imp)
    if m:
        put(d, 'sound.idPattern', m.group(1), 'code')
    if re.search(r"replace\\('-', '_'\\).*?\\.lower\\(\\)", imp, re.S):
        put(d, 'sound.mp3', {'sep': '_', 'case': 'lower'}, 'code')
    m = re.search(r"sheet = '(%d과)'", imp)
    if m:
        put(d, 'sound.sheet', m.group(1), 'code')
    m = re.search(r"fid, txt = str\\(r\\[(\\d+)\\].*?norm\\(r\\[(\\d+)\\]\\)", imp)
    if m:
        put(d, 'sound.col.id', int(m.group(1)), 'code')
        put(d, 'sound.col.text', int(m.group(2)), 'code')"""

NEW_SOUND_SCRAPE = """    # --- 소스에서: 음원·시트
    m = re.search(r"IDPAT = re\\.compile\\(r'([^']+)'\\)", imp)
    if m:
        put(d, 'sound.idPattern', m.group(1), 'code')
    # read_import.py 가 R('key', 기본값) 으로 쓰는 자리는 모두 이렇게 훑는다.
    # (sound.sheet / sound.col.id / sound.col.text / sound.mp3 / storyboard.sheet.syntax 등
    #  — read_import.py 에 R() 호출이 새로 생겨도 여기 코드를 매번 고치지 않아도 된다)
    import ast as _ast
    for mk, mv in re.findall(r"R\\(\\s*'([\\w.]+)'\\s*,\\s*(\\{[^}]*\\}|'[^']*'|\\d+)\\s*\\)", imp):
        try:
            val = _ast.literal_eval(mv)
        except Exception:
            continue
        put(d, mk, val, 'code')"""

apply(OLD_SOUND_SCRAPE, NEW_SOUND_SCRAPE, 'code_rules() 음원 스크래핑')

io.open(PATH, 'w', encoding='utf-8', newline='').write(src)
print('저장 완료:', PATH)
